# Machine-local runtime identity. `npm run bootstrap` writes `.env.local`.
DEJAML_EXPECTED_IMAGE_ID=sha256:replace-with-local-image-id
# Model providers. Keys belong in the deployment's secret store or process
# environment, never in the repository. The browser can only pick among the
# providers and models listed here; it never sees a key or a base URL.
# DEJAML_ANTHROPIC_API_KEY=
DEJAML_ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5
# DEJAML_OPENAI_API_KEY=
# DEJAML_OPENAI_MODELS=
# Cheaper Inference: a trusted third-party OpenAI-compatible gateway in front of
# Claude. It is NOT the official Anthropic API. Its endpoint is fixed in server
# code (https://api.cheaperinference.com/v1) and cannot be changed here; the only
# permitted model is claude-sonnet-5.5 (any other value is a configuration error).
# The owner's catalog check reported its discounted route at about 23.08%
# discounted pricing with zero-data-retention DISABLED: prompts and paper content
# sent through it may be retained by the gateway. Use it only for papers you may
# share with that third party.
# DEJAML_CHEAPER_INFERENCE_API_KEY=
DEJAML_CHEAPER_INFERENCE_MODELS=claude-sonnet-5.5
# An administrator-configured OpenAI-compatible endpoint (validated at startup;
# plain HTTP only for localhost with DEJAML_CUSTOM_ALLOW_LOCAL_HTTP=1).
# DEJAML_CUSTOM_BASE_URL=
# DEJAML_CUSTOM_MODELS=
# DEJAML_CUSTOM_API_KEY=
# Uploaders never bring keys: the browser picks only a listed provider and model.
# Per-model prices in USD per million tokens, as JSON. None are built in, so
# token counts are always tracked but cost is reported only for listed models.
# DEJAML_MODEL_PRICES={"my-model":{"inputPerMTok":1,"outputPerMTok":2}}
DEJAML_LAB_AGENT_ENABLED=1
# The lab platform. auto = the Docker host's own: Apple Silicon -> linux/arm64,
# Intel Mac or Linux x86-64 -> linux/amd64. Also: linux/amd64, linux/arm64,
# or a named target (apple-silicon-dev, intel-dev, aws-cpu). Wheels, images, caches and
# receipts all follow it; nothing runs under emulation.
DEJAML_PLATFORM=auto
# Default Python for platform checks; each approved plan chooses its own (3.10-3.13).
DEJAML_PYTHON_VERSION=3.11
# Papers without a reviewed case go to the multi-agent study; 0 keeps them inconclusive.
DEJAML_AUTONOMOUS=1
# Independent Lab Engineers per study, each in its own sealed offline lab (1-3).
DEJAML_LAB_ENGINEERS=1
# Typed re-plans allowed per study (each reason at most once).
DEJAML_MAX_REPLANS=2
DEJAML_STUDY_MAX_MINUTES=180
DEJAML_COMMAND_TIMEOUT_SECONDS=900
DEJAML_LAB_TIMEOUT_SECONDS=1800
# Trust zone 2: Python wheels are fetched by egress-restricted prep containers
# (0 disables it; labs then have only the image's Python). Binary wheels only,
# hash-checked, CPU-only (CUDA/ROCm/accelerator packages are always refused).
DEJAML_PREP_ENABLED=1
# Prep images are digest-pinned per Python version; override with a comma list if needed.
# Pin the multi-platform index digest: a single platform's manifest digest is refused for the other platform.
# DEJAML_PREP_IMAGES=3.11=python:3.11-slim-trixie@sha256:...,3.13=...
# 1 lets the preparer pull a missing pinned image by digest.
DEJAML_PREP_PULL=0
# auto: resolve natively when Docker can run the target platform, else pip's cross-platform mode.
DEJAML_PREP_RESOLVER_MODE=auto
# Disk bounds for wheel downloads (disk-backed temp storage, streamed).
DEJAML_PREP_MAX_FILE_MB=1024
DEJAML_PREP_MAX_TOTAL_MB=3072
DEJAML_PREP_MAX_TEMP_MB=6144
DEJAML_PREP_MAX_TEMP_INODES=200000
DEJAML_PREP_MIN_FREE_MB=1024
# DEJAML_PREP_ALLOWED_HOSTS=pypi.org,files.pythonhosted.org
# Project-owned compatibility constraints live in config/compatibility-constraints.txt.
# Only on networks that intercept TLS: a CA bundle the prep containers trust.
# DEJAML_PREP_CA_BUNDLE=
# Trust zone 3 (datasets): dataset downloads are refused unless their host is listed here.
DEJAML_DATASET_ALLOWED_HOSTS=

# The API is intentionally local-only because it has no authentication.
HOST=127.0.0.1
PORT=8787
