# Machine-local runtime identity. `npm run bootstrap` writes `.env.local`.
DEJAML_EXPECTED_IMAGE_ID=sha256:replace-with-local-image-id
OPENCLAW_BIN=openclaw

# Dedicated OpenClaw agents. These names are not credentials.
DEJAML_PAPER_AGENT=dejaml-paper
DEJAML_CODE_AGENT=dejaml-code
DEJAML_LEAD_AGENT=dejaml-lead
DEJAML_AUDIT_AGENT=dejaml-audit

# The API is intentionally local-only because it has no authentication.
HOST=127.0.0.1
PORT=8787
