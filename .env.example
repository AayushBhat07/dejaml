# Machine-local runtime identity. `npm run bootstrap` writes `.env.local`.
DEJAML_EXPECTED_IMAGE_ID=sha256:replace-with-local-image-id
# Server-side model connection. Keep DEJAML_MODEL_API_KEY in the deployment's
# secret store or process environment, never in the repository.
DEJAML_MODEL_BASE_URL=https://api.openai.com/v1
DEJAML_MODEL=replace-with-a-supported-model
DEJAML_LAB_AGENT_ENABLED=1

# The API is intentionally local-only because it has no authentication.
HOST=127.0.0.1
PORT=8787
