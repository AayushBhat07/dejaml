# Machine-local runtime identity. `npm run bootstrap` writes `.env.local`.
DEJAML_EXPECTED_IMAGE_ID=sha256:replace-with-local-image-id
# Model providers. Keys belong in the deployment's secret store or process
# environment, never in the repository. The browser can only pick among the
# providers and models listed here; it never sees a key or a base URL.
# DEJAML_ANTHROPIC_API_KEY=
DEJAML_ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5
# DEJAML_OPENAI_API_KEY=
# DEJAML_OPENAI_MODELS=
# An administrator-configured OpenAI-compatible endpoint (validated at startup;
# plain HTTP only for localhost with DEJAML_CUSTOM_ALLOW_LOCAL_HTTP=1).
# DEJAML_CUSTOM_BASE_URL=
# DEJAML_CUSTOM_MODELS=
# DEJAML_CUSTOM_API_KEY=
# 1 lets an uploader bring their own key for a listed provider (used in memory only).
DEJAML_ALLOW_UPLOADER_KEYS=1
# Per-model prices in USD per million tokens, as JSON. None are built in, so
# token counts are always tracked but cost is reported only for listed models.
# DEJAML_MODEL_PRICES={"my-model":{"inputPerMTok":1,"outputPerMTok":2}}
DEJAML_LAB_AGENT_ENABLED=1
# Papers without a reviewed case go to the multi-agent study; 0 keeps them inconclusive.
DEJAML_AUTONOMOUS=1
# Independent Lab Engineers per study, each in its own sealed offline lab (1-4).
DEJAML_LAB_ENGINEERS=2
DEJAML_STUDY_MAX_MINUTES=180
DEJAML_COMMAND_TIMEOUT_SECONDS=900
DEJAML_LAB_TIMEOUT_SECONDS=1800
# Trust zone 2: Python wheels are fetched by egress-restricted prep containers
# (0 disables it; labs then have only the image's Python).
DEJAML_PREP_ENABLED=1
DEJAML_PREP_IMAGE=python:3.13.15-slim-trixie
# DEJAML_PREP_IMAGE_ID=sha256:...
# DEJAML_PREP_ALLOWED_HOSTS=pypi.org,files.pythonhosted.org
# Only on networks that intercept TLS: a CA bundle the prep containers trust.
# DEJAML_PREP_CA_BUNDLE=
# Trust zone 3: dataset downloads are refused unless their host is listed here.
DEJAML_DATASET_ALLOWED_HOSTS=

# The API is intentionally local-only because it has no authentication.
HOST=127.0.0.1
PORT=8787
