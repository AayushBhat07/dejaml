{
  "name": "dejaml",
  "version": "0.1.0",
  "private": true,
  "description": "Same claim. One more run.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/run-workspaces.mjs build",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run check:native && npm run check:scripts && npm test",
    "check:native": "node scripts/check-native-runtime.mjs && node --test scripts/check-native-runtime.test.mjs",
    "check:scripts": "node --test scripts/env-local.test.mjs",
    "demo:replay": "npm run dev --workspace @dejaml/web",
    "verify:lab-image": "node lab-images/python-cpu/verify.mjs",
    "start:local": "node scripts/start-local.mjs",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "test": "node scripts/run-workspaces.mjs test",
    "start": "node apps/api/dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@dejaml/lab-manager": "0.1.0",
    "@dejaml/result-verifier": "0.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
